# Supported alternative when HR and POS use unrelated DNS domains.
server {
    listen 443 ssl http2;
    server_name people.example.com;
    ssl_certificate /etc/letsencrypt/live/people.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/people.example.com/privkey.pem;

    location /api/ {
        client_max_body_size 17m;
        proxy_pass http://127.0.0.1:4020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl http2;
    server_name checkout.example.net;
    ssl_certificate /etc/letsencrypt/live/checkout.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/checkout.example.net/privkey.pem;

    location /api/ {
        client_max_body_size 17m;
        proxy_pass http://127.0.0.1:4020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3021;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
