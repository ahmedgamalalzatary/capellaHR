# Replace customer.example and certificate paths with the installation's real values.
server {
    listen 443 ssl http2;
    server_name hr.customer.example;
    ssl_certificate /etc/letsencrypt/live/hr.customer.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hr.customer.example/privkey.pem;

    location /api/ {
        client_max_body_size 17m;
        proxy_pass http://127.0.0.1:4020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl http2;
    server_name pos.customer.example;
    ssl_certificate /etc/letsencrypt/live/pos.customer.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos.customer.example/privkey.pem;

    location /api/ {
        client_max_body_size 17m;
        proxy_pass http://127.0.0.1:4020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3021;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
